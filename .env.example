# Copy to .env and fill values (see README). Do not commit .env.
#
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_or_publishable_key
#
# LICENSE_SUPABASE_URL=https://YOUR_LICENSE_PROJECT.supabase.co
# LICENSE_SUPABASE_ANON_KEY=your_license_project_anon_key
#
# LICENSE_LOCAL_CACHE_PREFS_KEY=license_row_enc_v1
# LICENSE_LOCAL_CACHE_SECURE_KEY=license_row_aes_key_b64
#
# Flutter reads compile-time defines from dart_defines.json:
#   flutter run --dart-define-from-file=dart_defines.json
#
# Or pass inline:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
